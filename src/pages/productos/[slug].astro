---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteInfo } from '../../data/siteInfo';
import { presentaciones } from '../../data/presentaciones';
import logoM from '../../assets/img/logos/letra-m.svg';
import { Picture } from 'astro:assets';


type ImgMetadata = any;
const bottleImages = import.meta.glob(
	'/src/assets/img/botellas/*.{jpg,jpeg,png,webp}',
	{ eager: true, import: 'default' }
) as Record<string, ImgMetadata>;

export async function getStaticPaths() {
	return presentaciones.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const producto = presentaciones.find((p) => p.slug === slug);

if (!producto) {
	throw new Error(`Producto no encontrado: ${slug}`);
}

const getBottleImageObj = (fileName: string | null) => {
	if (!fileName) return logoM;
	const key = `/src/assets/img/botellas/${fileName}`;
	return bottleImages[key] ?? logoM;
};

const waMinorista = `https://wa.me/${siteInfo.contact.phoneWa}?text=${encodeURIComponent(
	`Hola, quiero consultar disponibilidad y precio de la presentación: Aceite de soja Muccino ${producto.size}.`
)}`;

const waMayorista = `https://wa.me/${siteInfo.contact.phoneWa}?text=${encodeURIComponent(
	`Hola, quiero solicitar catálogo mayorista. Me interesa el formato ${producto.size}. ¿Me brindan detalles de compra?`
)}`;

const pageTitle = `${producto.title} | ${siteInfo.name}`;
const pageDesc = `${producto.description} Presentación: ${producto.size}.`;
---

<BaseLayout title={pageTitle} description={pageDesc}>
	<div class="mx-auto max-w-6xl px-4 py-8">
		<!-- Breadcrumb -->
		<nav class="text-xs sm:text-sm text-charcoal-muted">
			<a class="hover:text-forest transition" href="/">Inicio</a>
			<span class="mx-2">/</span>
			<a class="hover:text-forest transition" href="/productos">Productos</a>
			<span class="mx-2">/</span>
			<span class="text-charcoal font-medium">{producto.size}</span>
		</nav>

		<div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-8">
			<!-- Imagen -->
			<div class="rounded-3xl border border-border-warm bg-cream-dark/25 p-6 flex flex-col justify-between backdrop-blur-sm shadow-sm">
				<div class="flex items-center justify-between">
					<div
						class="inline-flex items-center gap-2 rounded-full border border-border-warm bg-cream px-3.5 py-1 text-xs text-charcoal-muted">
						<span class="h-2 w-2 rounded-full bg-forest animate-pulse"></span>
						<span class="font-bold font-sans">Fraccionado en Villa Elisa</span>
					</div>
				</div>

				<div class="my-8 flex items-center justify-center min-h-[300px]">
					<Picture
						src={getBottleImageObj(producto.image)}
						formats={['avif', 'webp']}
						widths={[400, 800]}
						sizes="(max-width: 768px) 100vw, 800px"
						alt={producto.title}
						class="max-h-[380px] w-auto object-contain transition-transform duration-300 hover:scale-105"
						loading="eager"
					/>
				</div>

				<div class="border-t border-border-warm/60 pt-4 text-xs sm:text-sm">
					<div class="font-bold text-terracotta">{producto.highlight}</div>
					<div class="text-charcoal-muted mt-1">
						Aceite de soja comestible · Envase de {producto.size}
					</div>
				</div>
			</div>

			<!-- Contenido comercial -->
			<div class="flex flex-col justify-between">
				<div>
					<span class="text-[10px] font-bold tracking-widest text-forest uppercase">
						ACEITE DE SOJA COMESTIBLE
					</span>
					<h1 class="font-serif mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-charcoal">
						{producto.title}
					</h1>

					<p class="mt-4 text-charcoal-muted leading-relaxed text-sm sm:text-base">{producto.description}</p>

					<div class="mt-6 flex flex-wrap gap-2">
						<span
							class="rounded-full border border-border-warm bg-cream px-3.5 py-1.5 text-xs text-charcoal font-semibold shadow-sm">
							USO: {producto.use.toUpperCase()}
						</span>
						<span
							class="rounded-full border border-border-warm bg-cream px-3.5 py-1.5 text-xs text-charcoal font-semibold shadow-sm">
							PRESENTACIÓN: {producto.size}
						</span>
						<span
							class="rounded-full border border-border-warm bg-cream px-3.5 py-1.5 text-xs text-charcoal font-semibold shadow-sm">
							VOLUMEN: {producto.litros} L
						</span>
					</div>

					<!-- Beneficios -->
					<div class="mt-6 rounded-3xl border border-border-warm bg-cream-dark/20 p-5 shadow-sm">
						<div class="font-serif font-bold text-charcoal text-sm">Características Principales</div>
						<ul class="mt-3.5 space-y-2 text-sm text-charcoal-muted">
							{
								producto.bullets.map((b) => (
									<li class="flex gap-2">
										<span class="text-terracotta">•</span>
										<span>{b}</span>
									</li>
								))
							}
						</ul>
					</div>

					<!-- Ideal para -->
					<div class="mt-4 rounded-3xl border border-border-warm bg-cream-dark/20 p-5 shadow-sm">
						<div class="font-serif font-bold text-charcoal text-sm">Recomendado para</div>
						<div class="mt-3 flex flex-wrap gap-2">
							{
								producto.idealFor.map((t) => (
									<span class="rounded-full bg-cream border border-border-warm px-3 py-1 text-xs text-charcoal-muted shadow-sm hover:border-forest/40 hover:text-forest transition">
										{t}
									</span>
								))
							}
						</div>
					</div>
				</div>

				<!-- CTAs -->
				<div class="mt-8 border-t border-border-warm/60 pt-6">
					<div class="flex flex-col sm:flex-row gap-3">
						<a
							href={waMinorista}
							target="_blank"
							rel="noopener"
							class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-terracotta px-5 py-3 text-sm font-bold text-cream hover:bg-terracotta-light transition shadow-md shadow-terracotta/20 cursor-pointer">
							<svg class="h-4 w-4 fill-current text-cream" viewBox="0 0 24 24">
								<path d="M20.52 3.48A11.94 11.94 0 0 0 12.07 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.97L0 24l6.28-1.64a11.86 11.86 0 0 0 5.79 1.48h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.46-8.46z" />
							</svg>
							Consultar Disponibilidad
						</a>
						<a
							href={waMayorista}
							target="_blank"
							rel="noopener"
							class="inline-flex items-center justify-center rounded-xl border border-border-warm bg-cream px-5 py-3 text-sm font-bold text-charcoal hover:border-forest hover:bg-cream-dark/25 transition cursor-pointer">
							Pedir Precios Mayoristas
						</a>
					</div>

					<div class="mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-charcoal-muted">
						<div>
							WhatsApp Ventas: <span class="text-charcoal font-bold">{siteInfo.contact.phoneWaDisplay}</span>
						</div>
						<a
							href="/productos"
							class="text-forest hover:text-forest-light transition font-semibold">
							← Volver al Catálogo
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Relacionados -->
		<section class="mt-16 border-t border-border-warm/60 pt-12">
			<h2 class="font-serif text-2xl font-bold text-charcoal">Otras Presentaciones</h2>
			<p class="text-charcoal-muted text-sm mt-1">Conocé otros formatos y capacidades disponibles.</p>
			<div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4">
				{
					presentaciones
						.filter((p) => p.slug !== producto.slug)
						.slice(0, 4)
						.map((p) => (
							<a
								href={`/productos/${p.slug}`}
								class="group rounded-3xl border border-border-warm bg-cream-dark/20 p-5 hover:bg-cream-light transition duration-300 hover:border-forest/40">
								<div class="text-[9px] font-bold tracking-wider text-charcoal-muted uppercase">
									ACEITE DE SOJA
								</div>
								<div class="font-serif mt-2 text-lg font-bold text-charcoal group-hover:text-forest transition-colors">{p.size}</div>
								<div class="mt-1 text-xs text-charcoal-muted">{p.use}</div>
							</a>
						))
				}
			</div>
		</section>

		<!-- Cómo comprar -->
		<div class="mt-10 rounded-3xl border border-border-warm bg-cream-dark/20 p-6 backdrop-blur-sm shadow-sm">
			<h3 class="font-serif font-bold text-charcoal text-base">Proceso de Compra Simple</h3>
			<p class="mt-2 text-xs sm:text-sm text-charcoal-muted leading-relaxed max-w-xl">
				Como planta fraccionadora institucional, coordinamos todas las entregas y retiros directamente por teléfono o canales digitales.
			</p>

			<ol class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
				<li class="flex gap-3">
					<div
						class="h-8 w-8 shrink-0 rounded-full bg-forest flex items-center justify-center font-bold text-cream text-sm shadow-sm">
						1
					</div>
					<div class="leading-relaxed">
						<span class="font-bold text-charcoal">Definí el Tamaño</span>
						<p class="text-xs text-charcoal-muted mt-1">Confirmá la cantidad de litros que necesitás.</p>
					</div>
				</li>

				<li class="flex gap-3">
					<div
						class="h-8 w-8 shrink-0 rounded-full bg-forest flex items-center justify-center font-bold text-cream text-sm shadow-sm">
						2
					</div>
					<div class="leading-relaxed">
						<span class="font-bold text-charcoal">Hacé tu Consulta</span>
						<p class="text-xs text-charcoal-muted mt-1">Escribinos a WhatsApp para cotizar y validar disponibilidad.</p>
					</div>
				</li>

				<li class="flex gap-3">
					<div
						class="h-8 w-8 shrink-0 rounded-full bg-forest flex items-center justify-center font-bold text-cream text-sm shadow-sm">
						3
					</div>
					<div class="leading-relaxed">
						<span class="font-bold text-charcoal">Coordiná la Entrega</span>
						<p class="text-xs text-charcoal-muted mt-1">Retirá de fábrica o programamos despacho según tu zona.</p>
					</div>
				</li>
			</ol>
		</div>
	</div>
</BaseLayout>
