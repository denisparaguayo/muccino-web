---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Catalogo from '../components/Catalogo.astro';
import Footer from '../components/Footer.astro';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import { siteInfo } from '../data/siteInfo';
---

<BaseLayout
	title={`Catálogo de Presentaciones | ${siteInfo.name}`}
	description={`Conocé todas las presentaciones de aceite de soja Muccino. Formatos ideales para el hogar, despensas y gastronomía.`}>
	<Header />
	<main class="py-8">
		<!-- Breadcrumb -->
		<div class="mx-auto max-w-6xl px-4 text-xs sm:text-sm text-charcoal-muted mb-4">
			<nav class="flex gap-2 items-center">
				<a class="hover:text-forest transition" href="/">Inicio</a>
				<span>/</span>
				<span class="text-charcoal font-medium">Productos</span>
			</nav>
		</div>
		
		<Catalogo />
	</main>
	<Footer />
	<WhatsappFloat />
</BaseLayout>
