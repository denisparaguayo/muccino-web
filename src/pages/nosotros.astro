---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import NosotrosPage from '../components/NosotrosPage.astro';
import { siteInfo } from '../data/siteInfo';
---

<BaseLayout
	title={`Nosotros | ${siteInfo.name}`}
	description={`${siteInfo.description} Planta de fraccionamiento en Villa Elisa, Paraguay.`}>
	<Header />
	<main class="py-8">
		<!-- Breadcrumb -->
		<div class="mx-auto max-w-6xl px-4 text-xs sm:text-sm text-charcoal-muted mb-4">
			<nav class="flex gap-2 items-center">
				<a class="hover:text-forest transition" href="/">Inicio</a>
				<span>/</span>
				<span class="text-charcoal font-medium">Nosotros</span>
			</nav>
		</div>
		
		<NosotrosPage />
	</main>
	<Footer />
	<WhatsappFloat />
</BaseLayout>
