---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import FormularioB2B from '../components/FormularioB2B.astro';
import Footer from '../components/Footer.astro';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import { siteInfo } from '../data/siteInfo';
---

<BaseLayout
	title={`Distribución Mayorista | ${siteInfo.name}`}
	description={`Sumate a nuestra red de distribución de aceite de soja Muccino. Abastecimiento constante y logística eficiente en todo Paraguay.`}>
	<Header />
	
	<main class="py-8">
		<!-- Breadcrumb -->
		<div class="mx-auto max-w-6xl px-4 text-xs sm:text-sm text-charcoal-muted mb-6">
			<nav class="flex gap-2 items-center">
				<a class="hover:text-forest transition" href="/">Inicio</a>
				<span>/</span>
				<span class="text-charcoal font-medium">Mayorista</span>
			</nav>
		</div>

		<!-- Hero de la sección -->
		<section class="mx-auto max-w-6xl px-4 pb-12">
			<div class="text-center max-w-3xl mx-auto space-y-4">
				<span class="inline-flex rounded-full bg-forest/10 px-3.5 py-1 text-xs font-semibold text-forest">
					Ventas por Volumen · Paraguay
				</span>
				<h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-charcoal leading-tight">
					Abastecimiento Confiable para tu Negocio
				</h1>
				<p class="text-base text-charcoal-muted leading-relaxed">
					En Muccino S.A. trabajamos de la mano con distribuidoras, despensas, supermercados y el sector gastronómico para garantizar stock continuo y una logística coordinada durante todo el año.
				</p>
			</div>
		</section>

		<!-- Beneficios Mayoristas -->
		<section class="mx-auto max-w-6xl px-4 py-8 border-t border-border-warm/60">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<div class="rounded-3xl border border-border-warm bg-cream-dark/25 p-6 space-y-3 backdrop-blur-sm hover:bg-cream-light hover:shadow-md transition-all duration-300">
					<div class="h-10 w-10 rounded-xl bg-mustard/15 flex items-center justify-center text-mustard">
						<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
						</svg>
					</div>
					<h3 class="font-serif text-lg font-bold text-charcoal">Stock Todo el Año</h3>
					<p class="text-xs sm:text-sm text-charcoal-muted leading-relaxed">
						Evitamos quiebres en góndolas manteniendo inventarios robustos de todas nuestras presentaciones de aceite de soja.
					</p>
				</div>

				<div class="rounded-3xl border border-border-warm bg-cream-dark/25 p-6 space-y-3 backdrop-blur-sm hover:bg-cream-light hover:shadow-md transition-all duration-300">
					<div class="h-10 w-10 rounded-xl bg-forest/15 flex items-center justify-center text-forest">
						<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
						</svg>
					</div>
					<h3 class="font-serif text-lg font-bold text-charcoal">Logística en todo el País</h3>
					<p class="text-xs sm:text-sm text-charcoal-muted leading-relaxed">
						Distribución eficiente en Gran Asunción y coordinación logística fluida para las principales cabeceras del interior.
					</p>
				</div>

				<div class="rounded-3xl border border-border-warm bg-cream-dark/25 p-6 space-y-3 backdrop-blur-sm hover:bg-cream-light hover:shadow-md transition-all duration-300">
					<div class="h-10 w-10 rounded-xl bg-terracotta/15 flex items-center justify-center text-terracotta">
						<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
					</div>
					<h3 class="font-serif text-lg font-bold text-charcoal">Precios Altamente Competitivos</h3>
					<p class="text-xs sm:text-sm text-charcoal-muted leading-relaxed">
						Ofrecemos una excelente relación calidad-precio y márgenes atractivos para que puedas hacer crecer tu distribuidora o negocio.
					</p>
				</div>
			</div>
		</section>

		<!-- Formulario B2B -->
		<FormularioB2B />
	</main>

	<Footer />
	<WhatsappFloat />
</BaseLayout>
