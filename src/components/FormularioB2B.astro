---
import { siteInfo } from "../data/siteInfo";

const waFallbackLink = `https://wa.me/${siteInfo.contact.phoneWa}`;
---

<section id="contacto-mayorista" class="mx-auto max-w-6xl px-4 py-16">
  <section id="contacto-mayorista" class="mx-auto max-w-6xl px-4 py-16">
    <div
      class="rounded-3xl border border-border-warm bg-cream-dark/25 overflow-hidden backdrop-blur-sm shadow-xl"
    >
      <div class="grid grid-cols-1 lg:grid-cols-5">
        <!-- Info Panel -->
        <div
          class="lg:col-span-2 bg-forest p-8 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-forest-light/35 text-cream"
        >
          <div>
            <span
              class="text-xs font-bold uppercase tracking-wider text-mustard"
            >
              Distribución Mayorista
            </span>
            <h3
              class="font-serif mt-2 text-2xl sm:text-3xl font-bold text-cream tracking-tight"
            >
              ¿Querés distribuir Muccino en tu zona?
            </h3>
            <p class="mt-4 text-sm text-cream/80 leading-relaxed">
              Completá el formulario con los datos de tu negocio y te
              redirigiremos a nuestro canal mayorista en WhatsApp con el mensaje
              estructurado para agilizar tu cotización.
            </p>
          </div>

          <div class="mt-8 space-y-4">
            <div class="flex items-center gap-3">
              <div
                class="h-9 w-9 rounded-xl bg-forest-light/60 border border-cream/15 flex items-center justify-center text-mustard"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div class="text-xs">
                <div class="font-semibold text-cream">Nuestra Planta</div>
                <div class="text-cream/70">{siteInfo.contact.address}</div>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div
                class="h-9 w-9 rounded-xl bg-forest-light/60 border border-cream/15 flex items-center justify-center text-mustard"
              >
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                  <path
                    d="M20.52 3.48A11.94 11.94 0 0 0 12.07 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.97L0 24l6.28-1.64a11.86 11.86 0 0 0 5.79 1.48h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.46-8.46z"
                  ></path>
                </svg>
              </div>
              <div class="text-xs">
                <div class="font-semibold text-cream">Consultas Directas</div>
                <div class="text-cream/70">
                  {siteInfo.contact.phoneWaDisplay}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Panel -->
        <form
          id="b2b-form"
          class="lg:col-span-3 p-8 flex flex-col gap-5 bg-cream-light/65"
          data-phone-wa={siteInfo.contact.phoneWa}
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-2">
              <label
                class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
                for="b2b-nombre"
              >
                Tu Nombre completo *
              </label>
              <input
                id="b2b-nombre"
                name="nombre"
                type="text"
                required
                placeholder="Ej: Analia Gomez"
                class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal placeholder:text-charcoal-muted/40 focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
              />
            </div>

            <div class="flex flex-col gap-2">
              <label
                class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
                for="b2b-empresa"
              >
                Nombre del Negocio *
              </label>
              <input
                id="b2b-empresa"
                name="empresa"
                type="text"
                required
                placeholder="Ej: Distribuidora San José"
                class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal placeholder:text-charcoal-muted/40 focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-2">
              <label
                class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
                for="b2b-ciudad"
              >
                Ciudad o Departamento *
              </label>
              <input
                id="b2b-ciudad"
                name="ciudad"
                type="text"
                required
                placeholder="Ej: Villa Elisa / Central"
                class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal placeholder:text-charcoal-muted/40 focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
              />
            </div>

            <div class="flex flex-col gap-2">
              <label
                class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
                for="b2b-rubro"
              >
                Tipo de Rubro / Negocio *
              </label>
              <select
                id="b2b-rubro"
                name="rubro"
                required
                class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
              >
                <option value="" disabled selected>Seleccioná uno...</option>
                <option value="Distribuidor / Mayorista"
                  >Distribuidor / Mayorista</option
                >
                <option value="Despensa / Minimarket"
                  >Despensa / Minimarket</option
                >
                <option value="Gastronomía / Restaurante"
                  >Gastronomía / Restaurante</option
                >
                <option value="Supermercado">Supermercado</option>
                <option value="Otro">Otro</option>
              </select>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label
              class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
              for="b2b-telefono"
            >
              Número de Celular *
            </label>
            <input
              id="b2b-telefono"
              name="telefono"
              type="tel"
              required
              placeholder="Ej: 0982649300"
              class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal placeholder:text-charcoal-muted/40 focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label
              class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
              for="b2b-mensaje"
            >
              Mensaje o consulta específica
            </label>
            <textarea
              id="b2b-mensaje"
              name="mensaje"
              rows="3"
              placeholder="Ej: Quisiera recibir catálogo mayorista y precios para distribución en..."
              class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal placeholder:text-charcoal-muted/40 focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
            ></textarea>
          </div>

          <div
            class="mt-2 flex flex-col sm:flex-row gap-4 items-center justify-between"
          >
            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-terracotta px-6 py-3.5 text-sm font-bold text-cream hover:bg-terracotta-light active:scale-[0.98] transition shadow-md shadow-terracotta/20 cursor-pointer"
            >
              Enviar Solicitud por WhatsApp
            </button>
            <a
              href={waFallbackLink}
              target="_blank"
              rel="noopener"
              class="text-xs text-charcoal-muted hover:text-forest transition"
            >
              Chatear directo sin formulario
            </a>
          </div>
        </form>
      </div>
    </div>

    <script is:inline>
      (() => {
        const form = document.getElementById("b2b-form");
        if (!form) return;

        form.addEventListener("submit", (e) => {
          e.preventDefault();

          const phoneWa = form.dataset.phoneWa;
          const nombre = document.getElementById("b2b-nombre")?.value.trim();
          const empresa = document.getElementById("b2b-empresa")?.value.trim();
          const ciudad = document.getElementById("b2b-ciudad")?.value.trim();
          const rubro = document.getElementById("b2b-rubro")?.value;
          const telefono = document
            .getElementById("b2b-telefono")
            ?.value.trim();
          const mensaje = document.getElementById("b2b-mensaje")?.value.trim();

          if (!phoneWa || !nombre || !empresa || !ciudad || !rubro || !telefono)
            return;

          const lines = [];
          lines.push("💼 *SOLICITUD DE DISTRIBUCIÓN / MAYORISTA*");
          lines.push("----------------------------------------");
          lines.push(`*Nombre:* ${nombre}`);
          lines.push(`*Empresa/Negocio:* ${empresa}`);
          lines.push(`*Ciudad:* ${ciudad}`);
          lines.push(`*Rubro:* ${rubro}`);
          lines.push(`*Celular:* ${telefono}`);
          if (mensaje) {
            lines.push("----------------------------------------");
            lines.push(`*Consulta:* ${mensaje}`);
          }

          const waUrl = `https://wa.me/${phoneWa}?text=${encodeURIComponent(lines.join("\n"))}`;
          window.open(waUrl, "_blank", "noopener");
        });
      })();
    </script>
  </section>
</section>
