---
import { siteInfo } from "../data/siteInfo";
import { presentaciones } from "../data/presentaciones";
import logoM from "../assets/img/logos/letra-m.svg";
import { Picture } from "astro:assets";


type ImgMetadata = any;

const bottleImages = import.meta.glob(
  "/src/assets/img/botellas/*.{jpg,jpeg,png,webp}",
  { eager: true, import: "default" }
) as Record<string, ImgMetadata>;

const getBottleImageObj = (fileName: string | null) => {
  if (!fileName) return logoM;
  const key = `/src/assets/img/botellas/${fileName}`;
  return bottleImages[key] ?? logoM;
};

const getWaLink = (size: string) =>
  `https://wa.me/${siteInfo.contact.phoneWa}?text=${encodeURIComponent(
    `Hola, quiero consultar disponibilidad y precio del Aceite de soja Muccino en presentación de ${size}.`
  )}`;
---

<section id="productos" class="mx-auto max-w-6xl px-4 py-16">
  <div class="text-center max-w-2xl mx-auto">
    <span class="text-xs font-semibold uppercase tracking-wider text-terracotta">
      Catálogo de Presentaciones
    </span>
    <h2 class="font-serif mt-2 text-3xl font-bold tracking-tight text-charcoal sm:text-4xl">
      Nuestras Presentaciones
    </h2>
    <p class="mt-3 text-sm sm:text-base text-charcoal-muted">
      Envasamos aceite de soja comestible en formatos cómodos para el hogar y bidones de alta resistencia para el sector comercial.
    </p>
  </div>

  <!-- Tabs Filter Buttons -->
  <div class="mt-8 flex flex-wrap justify-center gap-2 sm:gap-3">
    <button
      type="button"
      data-filter="all"
      class="filter-btn active rounded-xl bg-forest px-4 py-2.5 text-xs sm:text-sm font-bold text-cream hover:bg-forest-light transition cursor-pointer"
    >
      Todos
    </button>
    <button
      type="button"
      data-filter="familiar"
      class="filter-btn rounded-xl bg-cream-dark/45 border border-border-warm px-4 py-2.5 text-xs sm:text-sm font-semibold text-charcoal hover:bg-cream-dark transition cursor-pointer"
    >
      Uso Familiar
    </button>
    <button
      type="button"
      data-filter="comercial"
      class="filter-btn rounded-xl bg-cream-dark/45 border border-border-warm px-4 py-2.5 text-xs sm:text-sm font-semibold text-charcoal hover:bg-cream-dark transition cursor-pointer"
    >
      Comercial / Gastronómico
    </button>
  </div>

  <!-- Products Grid -->
  <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {presentaciones.map((p) => {
      const isComercial = p.litros > 2;
      const category = isComercial ? 'comercial' : 'familiar';
      return (
        <div
          data-category={category}
          class="product-card group flex flex-col rounded-3xl border border-border-warm bg-cream-dark/25 overflow-hidden backdrop-blur-sm transition-all duration-300 hover:border-forest/30 hover:shadow-lg hover:shadow-charcoal/5"
        >
          <!-- Image Showcase -->
          <div class="relative bg-cream-light/60 p-6 flex items-center justify-center min-h-[220px] max-h-[240px] border-b border-border-warm/65">
            <a href={`/productos/${p.slug}`} class="block w-full">
              <Picture
                src={getBottleImageObj(p.image)}
                formats={['avif', 'webp']}
                widths={[240, 480]}
                sizes="(max-width: 640px) 240px, 480px"
                alt={p.title}
                class="mx-auto max-h-[180px] w-auto object-contain transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </a>
            
            <!-- Highlighting Tag -->
            <span class="absolute top-3 right-3 text-[10px] uppercase font-bold tracking-wider bg-forest text-cream px-2.5 py-1 rounded-md shadow-sm">
              {p.size}
            </span>
          </div>

          <!-- Product Details -->
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-[10px] font-bold tracking-widest text-forest uppercase">
              {p.use}
            </span>
            <a href={`/productos/${p.slug}`} class="mt-1 block">
              <h3 class="font-serif text-lg font-bold text-charcoal group-hover:text-forest transition-colors">
                {p.title}
              </h3>
            </a>
            <p class="mt-2.5 text-sm text-charcoal-muted leading-relaxed flex-grow">
              {p.description}
            </p>

            <!-- Metadata Line -->
            <div class="mt-4 flex items-center justify-between text-xs text-charcoal-muted border-t border-border-warm/65 pt-4">
              <span class="font-bold text-terracotta">{p.highlight}</span>
              <span class="text-border-warm font-bold">·</span>
              <span>Volumen: {p.litros} L</span>
            </div>

            <!-- Showcase Action CTAs -->
            <div class="mt-5 grid grid-cols-2 gap-2">
              <a
                href={`/productos/${p.slug}`}
                class="inline-flex items-center justify-center rounded-xl border border-border-warm bg-cream-light px-3 py-2.5 text-xs font-semibold text-charcoal hover:border-forest/40 hover:bg-cream-dark/25 transition text-center"
              >
                Ver Ficha
              </a>
              <a
                href={getWaLink(p.size)}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-terracotta px-3 py-2.5 text-xs font-bold text-cream hover:bg-terracotta-light transition text-center shadow-sm"
              >
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M20.52 3.48A11.94 11.94 0 0 0 12.07 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.97L0 24l6.28-1.64a11.86 11.86 0 0 0 5.79 1.48h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.46-8.46z" />
                </svg>
                Consultar
              </a>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<!-- Filter Script -->
<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.product-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      // Remove active class from all buttons
      buttons.forEach((b) => {
        b.classList.remove('active', 'bg-forest', 'text-cream', 'font-bold');
        b.classList.add('bg-cream-dark/45', 'border', 'border-border-warm', 'text-charcoal');
      });

      // Add active class to clicked button
      btn.classList.remove('bg-cream-dark/45', 'border', 'border-border-warm', 'text-charcoal');
      btn.classList.add('active', 'bg-forest', 'text-cream', 'font-bold');

      const filterValue = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        const category = card.getAttribute('data-category');
        if (filterValue === 'all' || category === filterValue) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>

<style>
  .filter-btn.active {
    box-shadow: 0 4px 12px rgba(27, 60, 41, 0.15);
  }
</style>
