---
import { siteInfo } from "../data/siteInfo";
import { presentaciones } from "../data/presentaciones";

const waBaseLink = `https://wa.me/${siteInfo.contact.phoneWa}`;
---

<section id="pedidos" class="mx-auto max-w-6xl px-4 py-8">
  <div
    class="rounded-3xl border border-border-warm bg-cream-dark/25 p-8 backdrop-blur-sm shadow-xl"
  >
    <div class="flex flex-col gap-2 max-w-xl">
      <span class="text-xs font-bold uppercase tracking-wider text-terracotta">
        Armá tu consulta
      </span>
      <h2
        class="font-serif text-2xl sm:text-3xl font-bold text-charcoal tracking-tight"
      >
        Detalle del Pedido
      </h2>
      <p class="text-charcoal-muted text-sm leading-relaxed mt-1">
        Ingresá tus datos de contacto y seleccioná las presentaciones que te
        interesan. Te generaremos un mensaje formateado para enviar directo por
        WhatsApp y coordinar la entrega o retiro.
      </p>
    </div>

    <form
      id="pedidos-form"
      class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-8"
      data-phone-wa={siteInfo.contact.phoneWa}
    >
      <!-- Datos del cliente -->
      <div class="flex flex-col gap-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex flex-col gap-2">
            <label
              class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
              for="pedido-nombre"
            >
              Nombre completo *
            </label>
            <input
              id="pedido-nombre"
              name="nombre"
              type="text"
              required
              autocomplete="name"
              placeholder="Ej: Analía Gómez"
              class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal placeholder:text-charcoal-muted/40 focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label
              class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
              for="pedido-telefono"
            >
              Teléfono de contacto *
            </label>
            <input
              id="pedido-telefono"
              name="telefono"
              type="tel"
              required
              autocomplete="tel"
              inputmode="tel"
              placeholder="Ej: 0982649300"
              class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal placeholder:text-charcoal-muted/40 focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex flex-col gap-2">
            <label
              class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
              for="pedido-tipo"
            >
              Tipo de Cliente
            </label>
            <select
              id="pedido-tipo"
              name="tipo"
              class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
            >
              <option value="Familiar">Familiar / Consumidor final</option>
              <option value="Comercial / Mayorista"
                >Comercial / Mayorista</option
              >
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label
              class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
              for="pedido-entrega"
            >
              Forma de Entrega
            </label>
            <select
              id="pedido-entrega"
              name="entrega"
              class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
            >
              <option value="A coordinar">A coordinar logística</option>
              <option value="Envío a domicilio">Envío a domicilio</option>
              <option value="Retiro de Fábrica (Villa Elisa)"
                >Retiro de Fábrica (Villa Elisa)</option
              >
            </select>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label
            class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
            for="pedido-direccion"
          >
            Dirección (opcional)
          </label>
          <input
            id="pedido-direccion"
            name="direccion"
            type="text"
            autocomplete="street-address"
            placeholder="Barrio, ciudad y referencias de entrega..."
            class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal placeholder:text-charcoal-muted/40 focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label
            class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
            for="pedido-notas"
          >
            Comentarios o notas adicionales
          </label>
          <textarea
            id="pedido-notas"
            name="notas"
            rows="3"
            placeholder="Ej: Horarios de atención para entrega, aclaración sobre el volumen, etc."
            class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal placeholder:text-charcoal-muted/40 focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
          ></textarea>
        </div>
      </div>

      <!-- Items y CTA -->
      <div class="flex flex-col justify-between gap-6">
        <div class="space-y-4">
          <div
            class="flex items-center justify-between gap-3 border-b border-border-warm/60 pb-2"
          >
            <h3 class="font-serif font-bold text-charcoal text-sm">
              Productos Seleccionados
            </h3>
            <button
              id="pedido-add-item"
              type="button"
              class="rounded-xl border border-border-warm bg-cream px-3.5 py-1.5 text-xs font-bold text-charcoal hover:border-forest/35 hover:bg-cream-dark/25 transition shadow-sm cursor-pointer"
            >
              + Agregar Producto
            </button>
          </div>

          <div
            id="pedido-items"
            class="space-y-4 max-h-[300px] overflow-y-auto pr-1"
          >
          </div>
        </div>

        <div class="border-t border-border-warm/60 pt-6 space-y-4">
          <div
            class="flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between"
          >
            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-terracotta px-6 py-3.5 text-sm font-bold text-cream hover:bg-terracotta-light active:scale-[0.98] transition shadow-md shadow-terracotta/20 cursor-pointer"
            >
              Enviar Consulta por WhatsApp
            </button>

            <a
              href={waBaseLink}
              target="_blank"
              rel="noopener"
              class="text-xs text-charcoal-muted hover:text-forest transition text-center sm:text-left"
            >
              Consultar sin armar pedido
            </a>
          </div>

          <div
            class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-charcoal-muted"
          >
            <div>
              Celular / WhatsApp: <span class="text-charcoal font-bold"
                >{siteInfo.contact.phoneWaDisplay}</span
              >
            </div>
            <div>
              Línea Baja: <span class="text-charcoal font-bold"
                >{siteInfo.contact.phoneLandlineDisplay}</span
              >
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <template id="pedido-item-template">
    <div
      class="grid grid-cols-[1fr_5.5rem_auto] gap-3 items-end bg-cream-light/65 p-3.5 rounded-2xl border border-border-warm shadow-sm"
    >
      <div class="flex flex-col gap-1.5">
        <label
          class="text-[10px] font-bold text-forest uppercase tracking-wider"
          >Presentación</label
        >
        <select
          required
          class="pedido-item-select w-full rounded-xl border border-border-warm bg-cream px-3 py-2.5 text-xs text-charcoal focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
        >
          <option value="" selected disabled>Elegir...</option>
          {
            presentaciones.map((p) => (
              <option value={p.size}>
                {p.size} ({p.use})
              </option>
            ))
          }
        </select>
      </div>

      <div class="flex flex-col gap-1.5">
        <label
          class="text-[10px] font-bold text-forest uppercase tracking-wider"
          >Cantidad</label
        >
        <input
          type="number"
          required
          min="1"
          step="1"
          value="1"
          class="pedido-item-qty w-full rounded-xl border border-border-warm bg-cream px-3 py-2.5 text-xs text-charcoal focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
        />
      </div>

      <button
        type="button"
        class="pedido-item-remove rounded-xl border border-red-200 bg-red-50 hover:bg-red-100/60 hover:border-red-300 px-3 py-2.5 text-xs font-bold text-red-650 transition cursor-pointer"
        aria-label="Quitar item"
      >
        Quitar
      </button>
    </div>
  </template>

  <script is:inline>
    (() => {
      const form = document.getElementById("pedidos-form");
      const itemsRoot = document.getElementById("pedido-items");
      const addButton = document.getElementById("pedido-add-item");
      const template = document.getElementById("pedido-item-template");

      if (
        !form ||
        !itemsRoot ||
        !addButton ||
        !(template instanceof HTMLTemplateElement)
      ) {
        return;
      }

      const addItem = () => {
        const fragment = template.content.cloneNode(true);
        const container = fragment.firstElementChild;
        if (!container) return;

        const removeButton = container.querySelector(".pedido-item-remove");
        if (removeButton) {
          removeButton.addEventListener("click", () => {
            container.remove();
          });
        }

        itemsRoot.appendChild(container);
      };

      addButton.addEventListener("click", addItem);
      addItem(); // Iniciar con 1 item por defecto

      form.addEventListener("submit", (e) => {
        e.preventDefault();

        if (!form.reportValidity()) return;

        const phoneWa = form.dataset.phoneWa;
        if (!phoneWa) return;

        const nombre = (
          document.getElementById("pedido-nombre")?.value || ""
        ).trim();
        const telefono = (
          document.getElementById("pedido-telefono")?.value || ""
        ).trim();
        const tipo = (
          document.getElementById("pedido-tipo")?.value || ""
        ).trim();
        const entrega = (
          document.getElementById("pedido-entrega")?.value || ""
        ).trim();
        const direccion = (
          document.getElementById("pedido-direccion")?.value || ""
        ).trim();
        const notas = (
          document.getElementById("pedido-notas")?.value || ""
        ).trim();

        const itemEls = Array.from(itemsRoot.querySelectorAll(":scope > div"));
        const items = itemEls
          .map((el) => {
            const size =
              el.querySelector(".pedido-item-select")?.value?.trim() || "";
            const qtyRaw = el.querySelector(".pedido-item-qty")?.value || "1";
            const qty = Math.max(1, Number.parseInt(qtyRaw, 10) || 1);
            return size ? { size, qty } : null;
          })
          .filter(Boolean);

        if (!nombre || !telefono || items.length === 0) return;

        const lines = [];
        lines.push("🛒 *NUEVO PEDIDO DE ACEITES MUCCINO*");
        lines.push("----------------------------------------");
        lines.push(`*Nombre:* ${nombre}`);
        lines.push(`*Teléfono:* ${telefono}`);
        if (tipo) lines.push(`*Tipo de Cliente:* ${tipo}`);
        if (entrega) lines.push(`*Forma de Entrega:* ${entrega}`);
        if (direccion) lines.push(`*Dirección:* ${direccion}`);
        lines.push("----------------------------------------");
        lines.push("*Items Solicitados:*");
        for (const item of items) {
          lines.push(`- ${item.qty} caja(s)/unidad(es) de ${item.size}`);
        }
        if (notas) {
          lines.push("----------------------------------------");
          lines.push(`*Notas:* ${notas}`);
        }

        const waUrl = `https://wa.me/${phoneWa}?text=${encodeURIComponent(lines.join("\n"))}`;
        window.open(waUrl, "_blank", "noopener");
      });
    })();
  </script>
</section>
