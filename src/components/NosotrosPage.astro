---
import { siteInfo } from "../data/siteInfo";
import logoFull from "../assets/img/logos/logo-muccino-fondo-negro.svg";
import logoM from "../assets/img/logos/letra-m.svg";

const waConsultas = `https://wa.me/${siteInfo.contact.phoneWa}?text=${encodeURIComponent(
  "Hola, quiero realizar una consulta general sobre Aceites Muccino.",
)}`;
---

<section class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
  <!-- Header -->
  <div class="flex flex-col gap-4 max-w-3xl">
    <div
      class="inline-flex items-center gap-2 w-fit rounded-full border border-border-warm bg-cream px-3.5 py-1 text-xs text-charcoal-muted shadow-sm"
    >
      <span class="h-2 w-2 rounded-full bg-forest animate-pulse"></span>
      <span class="font-bold">Trayectoria Familiar</span>
      <span class="text-border-warm">•</span>
      <span class="text-charcoal-muted">Desde 2009 en Paraguay</span>
    </div>

    <h1
      class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-charcoal"
    >
      Nuestra Historia e Identidad
    </h1>
    <p class="text-charcoal-muted leading-relaxed text-base sm:text-lg">
      En <span class="font-semibold text-charcoal">{siteInfo.name}</span> nos dedicamos
      al fraccionamiento de aceite de soja comestible de alta calidad, controlando
      estrictamente cada etapa para ofrecer un producto de rendimiento garantizado.
    </p>
  </div>

  <!-- Bloques -->
  <div class="mt-10 grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Identidad -->
    <div
      class="rounded-3xl border border-border-warm bg-cream-dark/25 p-6 backdrop-blur-sm shadow-sm"
    >
      <div class="flex items-center gap-3">
        <img
          src={logoM.src}
          alt="Muccino"
          class="h-10 w-10 rounded-xl bg-cream p-1.5 border border-border-warm"
        />

        <div>
          <div class="text-xs text-forest uppercase font-bold tracking-wider">
            Quiénes somos
          </div>
          <div class="font-serif text-lg font-bold text-charcoal">
            Familia, Trabajo y Constancia
          </div>
        </div>
      </div>

      <p class="mt-4 text-sm text-charcoal-muted leading-relaxed">
        Somos una empresa familiar paraguaya con planta industrial propia. Nos
        enfocamos en brindar un suministro continuo de aceite de soja comestible
        para la mesa de los hogares e insumos de alto rendimiento para el sector
        gastronómico paraguayo.
      </p>

      <div class="mt-6 grid grid-cols-3 gap-3">
        <div
          class="rounded-2xl border border-border-warm bg-cream p-4 text-center shadow-sm"
        >
          <div class="font-serif text-xl sm:text-2xl font-bold text-terracotta">
            2009
          </div>
          <div class="text-[10px] text-charcoal-muted uppercase font-bold mt-1">
            Fundación
          </div>
        </div>
        <div
          class="rounded-2xl border border-border-warm bg-cream p-4 text-center shadow-sm"
        >
          <div class="font-serif text-xl sm:text-2xl font-bold text-forest">
            100%
          </div>
          <div class="text-[10px] text-charcoal-muted uppercase font-bold mt-1">
            Nacional
          </div>
        </div>
        <div
          class="rounded-2xl border border-border-warm bg-cream p-4 text-center shadow-sm"
        >
          <div class="font-serif text-xl sm:text-2xl font-bold text-mustard">
            Soja
          </div>
          <div class="text-[10px] text-charcoal-muted uppercase font-bold mt-1">
            Aceite
          </div>
        </div>
      </div>
    </div>

    <!-- Propuesta de valor -->
    <div
      class="rounded-3xl border border-border-warm bg-cream-dark/25 p-6 backdrop-blur-sm shadow-sm"
    >
      <div class="flex items-center justify-between gap-4">
        <img src={logoFull.src} alt="Muccino" class="h-8 w-auto" />
        <span class="text-xs text-forest font-bold uppercase tracking-wider"
          >Compromiso Muccino</span
        >
      </div>

      <div class="mt-6 space-y-4">
        <div
          class="rounded-2xl border border-border-warm bg-cream p-4 flex gap-4 items-start shadow-sm"
        >
          <div class="text-terracotta mt-0.5 shrink-0">
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <div class="font-serif font-bold text-charcoal text-sm">
              Fraccionamiento Controlado
            </div>
            <p class="mt-1 text-xs text-charcoal-muted leading-relaxed">
              Cumplimos con estrictas normas sanitarias en Villa Elisa para
              asegurar el sellado perfecto y la pureza en cada envase.
            </p>
          </div>
        </div>

        <div
          class="rounded-2xl border border-border-warm bg-cream p-4 flex gap-4 items-start shadow-sm"
        >
          <div class="text-forest mt-0.5 shrink-0">
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
              ></path>
            </svg>
          </div>
          <div>
            <div class="font-serif font-bold text-charcoal text-sm">
              Variedad para Cada Canal
            </div>
            <p class="mt-1 text-xs text-charcoal-muted leading-relaxed">
              Desde botellas compactas de 250ml hasta bidones industriales de 5L
              para abastecer a familias y profesionales.
            </p>
          </div>
        </div>

        <div
          class="rounded-2xl border border-border-warm bg-cream p-4 flex gap-4 items-start shadow-sm"
        >
          <div class="text-mustard mt-0.5 shrink-0">
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <div>
            <div class="font-serif font-bold text-charcoal text-sm">
              Atención y Consulta Ágil
            </div>
            <p class="mt-1 text-xs text-charcoal-muted leading-relaxed">
              Optimizamos la comunicación corporativa y mayorista a través de
              canales directos de WhatsApp y teléfono fijo.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Cómo comprar (mini) -->
  <div
    class="mt-6 rounded-3xl border border-border-warm bg-cream-dark/20 p-6 backdrop-blur-sm shadow-sm"
  >
    <h2 class="font-serif text-xl font-bold text-charcoal">
      ¿Cómo adquirir nuestros aceites?
    </h2>
    <p class="mt-2 text-sm text-charcoal-muted leading-relaxed max-w-xl">
      Como empresa institucional y de fraccionamiento, comercializamos nuestros
      productos mediante atención telefónica o derivando pedidos directamente a
      nuestros coordinadores comerciales:
    </p>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
      {
        [
          [
            "1",
            "Explorá el Catálogo",
            "Revisá las presentaciones en la web y elegí las ideales para tu volumen.",
          ],
          [
            "2",
            "Consultá Disponibilidad",
            "Escribinos o llamanos para coordinar cotizaciones y mínimos.",
          ],
          [
            "3",
            "Coordiná la Entrega",
            "Programamos el envío o retiro desde nuestra planta según tu ubicación.",
          ],
        ].map(([n, t, d]) => (
          <div class="rounded-2xl border border-border-warm bg-cream p-4 shadow-sm">
            <div class="flex items-center gap-3">
              <div class="h-8 w-8 rounded-full bg-forest flex items-center justify-center font-bold text-cream text-xs">
                {n}
              </div>
              <div class="font-serif font-bold text-charcoal">{t}</div>
            </div>
            <div class="mt-2.5 text-xs text-charcoal-muted leading-relaxed">
              {d}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-6 flex flex-col sm:flex-row gap-3 pt-2">
      <a
        href="/productos"
        class="inline-flex items-center justify-center rounded-xl bg-forest px-5 py-3 text-xs sm:text-sm font-bold text-cream hover:bg-forest-light transition shadow-md shadow-forest/15 cursor-pointer"
      >
        Explorar Presentaciones
      </a>

      <a
        href="/mayorista"
        class="inline-flex items-center justify-center rounded-xl border border-border-warm bg-cream px-5 py-3 text-xs sm:text-sm font-bold text-charcoal hover:bg-cream-dark/25 transition cursor-pointer"
      >
        Sección Distribución Mayorista
      </a>

      <a
        href={waConsultas}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-terracotta px-5 py-3 text-xs sm:text-sm font-bold text-cream hover:bg-terracotta-light transition shadow-md shadow-terracotta/20 cursor-pointer"
      >
        Consultar por WhatsApp
      </a>
    </div>

    <div
      class="mt-5 border-t border-border-warm/60 pt-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-charcoal-muted"
    >
      <div>
        Línea Baja: <span class="text-charcoal font-bold"
          >{siteInfo.contact.phoneLandlineDisplay}</span
        >
      </div>
      <div>
        WhatsApp: <span class="text-charcoal font-bold"
          >{siteInfo.contact.phoneWaDisplay}</span
        >
      </div>
    </div>
  </div>
</section>
