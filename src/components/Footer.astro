---
import { siteInfo } from "../data/siteInfo";
import logoFull from "../assets/img/logos/logo-muccino-fondo-negro.svg";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-forest-light/35 bg-forest text-cream/70 text-sm">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand Info -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <!-- muccino logo inside a cream background box to make it high contrast -->
          <div class="bg-cream p-1.5 rounded-xl">
            <img
              src={logoFull.src}
              alt="Muccino"
              class="h-8 w-auto filter invert brightness-0"
            />
          </div>
        </div>
        <p class="text-cream/80 leading-relaxed text-xs max-w-sm">
          {siteInfo.description}
        </p>

        <!-- Social Links -->
        <div class="flex items-center gap-4 pt-2">
          <a
            href={siteInfo.socials.facebook}
            target="_blank"
            rel="noopener"
            class="text-cream/70 hover:text-mustard transition"
            aria-label="Facebook"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
              <path
                d="M9 8H7v3h2v9h4v-9h3.6l.4-3H13V6c0-.5.5-1 1-1h2.5V1H13.6C10.5 1 9 2.5 9 5.5V8z"
              ></path>
            </svg>
          </a>
          <a
            href={siteInfo.socials.instagram}
            target="_blank"
            rel="noopener"
            class="text-cream/70 hover:text-mustard transition"
            aria-label="Instagram"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="space-y-3">
        <h4
          class="font-serif font-bold text-cream uppercase tracking-wider text-xs"
        >
          Secciones
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href="/productos"
              class="text-cream/80 hover:text-cream hover:underline transition"
            >
              Catálogo de Productos
            </a>
          </li>
          <li>
            <a
              href="/recetas"
              class="text-cream/80 hover:text-cream hover:underline transition font-semibold text-mustard"
            >
              Recetario Familiar
            </a>
          </li>
          <li>
            <a
              href="/mayorista"
              class="text-cream/80 hover:text-cream hover:underline transition"
            >
              Venta Mayorista
            </a>
          </li>
          <li>
            <a
              href="/nosotros"
              class="text-cream/80 hover:text-cream hover:underline transition"
            >
              Nuestra Fábrica
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Contact Numbers -->
      <div class="space-y-3">
        <h4
          class="font-serif font-bold text-cream uppercase tracking-wider text-xs"
        >
          Atención al Cliente
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <span class="block text-cream/50">Línea Baja</span>
            <a
              href={`tel:${siteInfo.contact.phoneLandline}`}
              class="text-cream/90 hover:text-cream transition"
            >
              {siteInfo.contact.phoneLandlineDisplay}
            </a>
          </li>
          <li>
            <span class="block text-cream/50">WhatsApp</span>
            <a
              href={`https://wa.me/${siteInfo.contact.phoneWa}`}
              target="_blank"
              rel="noopener"
              class="text-mustard hover:text-mustard/90 font-bold transition"
            >
              {siteInfo.contact.phoneWaDisplay}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Ubicación / Dirección -->
      <div class="space-y-3">
        <h4
          class="font-serif font-bold text-cream uppercase tracking-wider text-xs"
        >
          Fábrica
        </h4>
        <ul class="space-y-2 text-xs leading-relaxed">
          <li>
            <span class="block text-cream/50">Dirección</span>
            <a
              href={siteInfo.contact.googleMapsLink}
              target="_blank"
              rel="noopener"
              class="text-cream/90 hover:text-cream transition"
            >
              {siteInfo.contact.address}
            </a>
          </li>
          <li>
            <span class="block text-cream/50">Plus Code</span>
            <span class="text-cream/80 font-mono">
              {siteInfo.contact.plusCode}
            </span>
          </li>
          <li>
            <a
              href={siteInfo.contact.googleMapsLink}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1 text-mustard hover:text-mustard/90 font-bold transition"
            >
              <span>Ver en Google Maps</span>
              <svg
                class="h-3 w-3"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div
      class="mt-12 pt-8 border-t border-forest-light/35 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-cream/50"
    >
      <div>
        © {currentYear}
        {siteInfo.legalName}. Todos los derechos reservados.
      </div>
      <div class="flex gap-4">
        <span>Industria Paraguaya</span>
        <span>·</span>
        <span>Fraccionamiento de Aceite de Soja</span>
      </div>
    </div>
  </div>
</footer>
