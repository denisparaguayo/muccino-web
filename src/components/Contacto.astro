---
import { siteInfo } from "../data/siteInfo";

const waFallbackLink = `https://wa.me/${siteInfo.contact.phoneWa}`;
---

<section id="contacto" class="mx-auto max-w-6xl px-4 py-8">
  <div
    class="rounded-3xl border border-border-warm bg-cream-dark/25 p-8 flex flex-col md:flex-row md:items-start md:justify-between gap-8 backdrop-blur-sm shadow-xl"
  >
    <div class="md:max-w-sm space-y-4">
      <div>
        <span
          class="text-xs font-bold uppercase tracking-wider text-terracotta"
        >
          Canales de Atención
        </span>
        <h2
          class="font-serif text-2xl sm:text-3xl font-bold text-charcoal mt-1"
        >
          Contacto Directo
        </h2>
        <p class="text-charcoal-muted text-sm mt-2 leading-relaxed">
          Ponete en contacto con la administración o ventas para resolver
          cualquier consulta comercial sobre nuestros productos.
        </p>
      </div>

      <div class="space-y-3 pt-2">
        <div>
          <span
            class="text-[10px] text-forest font-bold uppercase tracking-widest block"
            >Línea Baja</span
          >
          <a
            href={`tel:${siteInfo.contact.phoneLandline}`}
            class="text-base font-semibold text-charcoal hover:text-forest transition"
          >
            {siteInfo.contact.phoneLandlineDisplay}
          </a>
        </div>
        <div>
          <span
            class="text-[10px] text-forest font-bold uppercase tracking-widest block"
            >Celular / WhatsApp</span
          >
          <a
            href={`https://wa.me/${siteInfo.contact.phoneWa}`}
            target="_blank"
            rel="noopener"
            class="text-base font-bold text-terracotta hover:text-terracotta-light transition"
          >
            {siteInfo.contact.phoneWaDisplay}
          </a>
        </div>
      </div>
    </div>

    <form
      id="contacto-form"
      class="w-full md:w-[28rem] flex flex-col gap-4"
      data-phone-wa={siteInfo.contact.phoneWa}
    >
      <div class="flex flex-col gap-2">
        <label
          class="text-xs font-bold text-charcoal-muted uppercase tracking-wider"
          for="contacto-mensaje"
        >
          Tu mensaje
        </label>
        <textarea
          id="contacto-mensaje"
          name="mensaje"
          required
          rows="4"
          placeholder="Escribí tu consulta sobre Aceites Muccino aquí..."
          class="w-full rounded-xl border border-border-warm bg-cream px-4 py-3 text-sm text-charcoal placeholder:text-charcoal-muted/40 focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest/50 transition"
        ></textarea>
      </div>

      <div
        class="flex flex-col sm:flex-row gap-4 sm:items-center sm:justify-between pt-2"
      >
        <button
          type="submit"
          class="rounded-xl bg-terracotta px-5 py-3 text-xs sm:text-sm font-bold text-cream hover:bg-terracotta-light active:scale-[0.98] transition shadow-md shadow-terracotta/20 cursor-pointer"
        >
          Enviar por WhatsApp
        </button>
        <a
          href={waFallbackLink}
          target="_blank"
          rel="noopener"
          class="text-xs text-charcoal-muted hover:text-forest transition"
        >
          Ir a WhatsApp directo
        </a>
      </div>
    </form>
  </div>

  <script is:inline>
    (() => {
      const form = document.getElementById("contacto-form");
      const textarea = document.getElementById("contacto-mensaje");
      if (!form || !textarea) return;

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const phoneWa = form.dataset.phoneWa;
        const userMessage = textarea.value.trim();
        if (!phoneWa || !userMessage) return;

        const waUrl = `https://wa.me/${phoneWa}?text=${encodeURIComponent(userMessage)}`;
        window.open(waUrl, "_blank", "noopener");
      });
    })();
  </script>
</section>
