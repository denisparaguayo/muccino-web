<section id="calidad" class="mx-auto max-w-6xl px-4 py-16">
	<h2 class="font-serif text-3xl font-bold tracking-tight text-charcoal">Calidad y Fraccionamiento</h2>
	<p class="text-sm sm:text-base text-charcoal-muted mt-2">
		Procesos pensados para consistencia, higiene y absoluta confianza.
	</p>

	<div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
		{
			[
				[
					'Fraccionamiento Controlado',
					'Cuidamos minuciosamente cada etapa para mantener un producto uniforme de máxima pureza.',
				],
				[
					'Envases Seguros y Robustos',
					'Sellado hermético de alta calidad para conservar la frescura y facilitar el transporte.',
				],
				[
					'Atención Directa y Eficiente',
					'Comunicación rápida y personalizada para coordinar despachos minoristas y mayoristas.',
				],
			].map(([t, d]) => (
				<div class="rounded-3xl border border-border-warm bg-cream-dark/25 p-6 backdrop-blur-sm shadow-sm hover:bg-cream-light hover:shadow-md transition-all duration-300">
					<div class="font-serif text-lg font-bold text-charcoal">{t}</div>
					<div class="text-sm text-charcoal-muted mt-2 leading-relaxed">{d}</div>
				</div>
			))
		}
	</div>
</section>
